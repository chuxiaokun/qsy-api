# 监听端口（宝塔 Nginx 反代到此端口）
PORT=3000

# 微信小程序（与 project.config.json 里 appid 一致）
WX_APPID=wx69d8ada06130a2ad
WX_APPSECRET=你的AppSecret

# JWT 签名密钥（小程序登录 + 管理后台登录共用，随机长字符串）
JWT_SECRET=请改成随机字符串

# MySQL（宝塔面板创建数据库后填写）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xiaoe
DB_PASSWORD=你的数据库密码
DB_NAME=qsy

# 管理后台登录（kunkit-admin 走 POST /api/admin/login）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=QWEqwe1207870455

# 与 kunkit-admin/.env.local 相同（管理接口备用鉴权，建议配置）
ADMIN_API_KEY=请改成随机字符串

# 头像等静态资源对外访问根地址（与小程序 API_BASE 一致，勿带末尾斜杠）
PUBLIC_BASE_URL=https://kit.baimengyan.cn

# 阿里云邮件推送 SMTP（华东1: smtpdm.aliyun.com，端口 465）
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mail.example.com
SMTP_PASS=控制台设置的SMTP密码
MAIL_FROM=小鹅 <noreply@mail.example.com>
